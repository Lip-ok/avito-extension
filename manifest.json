{
    "manifest_version": 3,
    "name": "Avito Cleaner",
    "version": "1.3",
    "description": "Удаляет VPN-модалку и возвращает скролл",
    "permissions": ["storage"],
    "content_scripts": [
      {
        "matches": ["*://*.avito.ru/*"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "action": {
      "default_popup": "popup.html"
    }
  }